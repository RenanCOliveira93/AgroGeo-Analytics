# Copie para .env (nunca versione o .env)
# Projeto Google Cloud registrado para uso do Earth Engine (obrigatório para ee.Initialize)
EE_PROJECT=seu-projeto-gcp
# 1 = notebooks usam Earth Engine real; 0 (padrão) = dados sintéticos offline
AGROGEO_USE_EE=0
# Código IBGE do município (Piraju/SP = 3538808)
MUNICIPIO_IBGE=3538808
# Período de análise
START_DATE=2021-01-01
END_DATE=2024-12-31
# Ano MapBiomas
MAPBIOMAS_YEAR=2023
